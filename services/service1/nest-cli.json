{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      "**/*.tpl",
      "**/*.md"
    ],
    "deleteOutDir": true,
    "watchAssets": true
  },
  "scripts": {
    "seed-test-users": {
      "executor": "@nestjs/cli:execute",
      "options": {
        "script": "scripts/seedTestUsers.ts"
      }
    }
  }
}
