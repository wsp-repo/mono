{
  "name": "@mono/monorepo",
  "description": "Common blank monorepo",
  "license": "UNLICENSED",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.22.3",
    "npm": ">=10.9.8"
  },
  "workspaces": [
    "migrations",
    "services/*",
    "shared"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsp-repo/mono.git"
  },
  "scripts": {
    "- 1 -": "Форматирование и тестирование",
    "format": "npm run format --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "lint:warns": "npm run lint:warns --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:e2e": "exit 0",
    "- 2 -": "Сборка исполняемого кода",
    "clean": "npm run clean --workspaces",
    "build": "npm run build --workspace=shared && npm run build --workspace=services",
    "build:prod": "npm run build:prod --workspace=shared && npm run build:prod --workspace=services",
    "shared:watch": "onchange -i -k 'shared/src/**/*.{ts,json}' 'shared/*.json' -- npm run build --workspace=shared",
    "- 3 -": "Запуск на выполнение проекта",
    "start:dev": "run-p start:dev:service1",
    "start:dev:service1": "npm run start:dev --workspace=services/service1"
  },
  "dependencies": {
    "@zalib/core": "^5.9.5",
    "@fastify/static": "^8.2.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/microservices": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.24",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.16.1",
    "fastify": "^5.4.0",
    "mime": "^4.1.0",
    "mongo-each": "^2.0.1",
    "mongodb": "^4.17.2",
    "nestjs-pino": "^4.6.1",
    "p-queue": "^9.0.1",
    "prom-client": "^15.1.3",
    "qs": "^6.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@zalib/devkit": "^5.9.5",
    "@nestjs/testing": "^11.1.9",
    "@types/p-queue": "^3.1.0",
    "@types/qs": "^6.14.0",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "pino-pretty": "^11.0.0",
    "tsc-alias": "^1.8.17"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ]
  }
}
